# Copy to server/.env and fill in real values. Never commit server/.env.

# Port the Express API listens on.
PORT=5000

# MongoDB connection string (local install, Docker, or MongoDB Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/rhythmictunes

# Secret used to sign and verify JWTs. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Note: external search uses the public iTunes Search API, so no Spotify
# or other third-party API keys are required.
